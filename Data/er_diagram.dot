/* ER diagram v jeziku DOT (Graphviz). Sliko osvežiš z:
   dot -Tpng Data/er_diagram.dot -o er-nepremicnine.png */

digraph ER {
    rankdir = LR;
    bgcolor = "white";
    splines = ortho;
    nodesep = 0.55;
    ranksep = 1.0;

    node [shape = plaintext, fontname = "Helvetica", fontsize = 11];
    edge [fontname = "Helvetica", fontsize = 9, color = "#44506a", arrowhead = none];

    /* Šifranti */

    vir [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#2f5d8a" COLSPAN="2"><FONT COLOR="white"><B>vir</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_vira</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ime_vira text NOT NULL <I>unique</I></TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">url_vira text</TD></TR>
        </TABLE>>];

    vrsta [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#2f5d8a" COLSPAN="2"><FONT COLOR="white"><B>vrsta_nepremicnine</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_vrste</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ime_vrste text NOT NULL <I>unique</I></TD></TR>
        </TABLE>>];

    regija [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#2f5d8a" COLSPAN="2"><FONT COLOR="white"><B>regija</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_regije</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ime_regije text NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">drzava char(2) NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT" COLSPAN="2"><I>unique (ime_regije, drzava)</I></TD></TR>
        </TABLE>>];

    lokacija [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#2f5d8a" COLSPAN="2"><FONT COLOR="white"><B>lokacija</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_lokacije</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_regije → regija</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">upravna_enota text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">obcina text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">naselje text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">postna_stevilka integer</TD></TR>
        </TABLE>>];

    /* Jedro */

    nepremicnina [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#24486b" COLSPAN="2"><FONT COLOR="white"><B>nepremicnina</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_nepremicnine</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_vrste → vrsta_nepremicnine</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_lokacije → lokacija</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">opis text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">leto_gradnje integer</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stevilo_sob numeric(4,1)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">stevilo_sob_opis varchar(100)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nadstropje varchar(50)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">m2 numeric(10,2) NOT NULL</TD></TR>
        </TABLE>>];

    oglas [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#c2410c" COLSPAN="2"><FONT COLOR="white"><B>oglas</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>id_oglasa</B> serial</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_vira → vir</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_nepremicnine → nepremicnina</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">zunanji_id text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">naslov text NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">url_oglasa text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cena numeric(12,2) NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valuta char(3)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">datum_objave date</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">datum_zajema date</TD></TR>
        <TR><TD ALIGN="LEFT" COLSPAN="2"><I>unique (id_vira, zunanji_id)</I></TD></TR>
        </TABLE>>];

    uporabnik [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
        <TR><TD BGCOLOR="#6b7484" COLSPAN="2"><FONT COLOR="white"><B>uporabnik</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>uporabnisko_ime</B> text</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">geslo_hash text NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">vloga text NOT NULL</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">zadnja_prijava timestamp</TD></TR>
        </TABLE>>];

    /* Povezave (kardinalnosti 1 : N) */

    regija       -> lokacija     [taillabel = "1", headlabel = "N", labeldistance = 2.0];
    vrsta        -> nepremicnina [taillabel = "1", headlabel = "N", labeldistance = 2.0];
    lokacija     -> nepremicnina [taillabel = "1", headlabel = "N", labeldistance = 2.0];
    nepremicnina -> oglas        [taillabel = "1", headlabel = "N", labeldistance = 2.0];
    vir          -> oglas        [taillabel = "1", headlabel = "N", labeldistance = 2.0];

    /* Uporabnik ni povezan z ostalimi tabelami – služi samo prijavi. */
    { rank = same; uporabnik; }
}
